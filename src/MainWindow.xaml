<Window x:Class="GoChartingPresets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="GoCharting Footprint Presets"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="GoCharting Footprint Presets"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007acc"
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Margin="0,0,0,16">
            <TabItem Header="Presets">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="btnApplyPreset" Content="Apply Preset" Width="140" Height="32" Click="BtnApplyPreset_Click"/>
                        <Button x:Name="btnExportPreset" Content="Export Preset" Width="140" Height="32" Margin="0,0,8,0" Click="BtnExportPreset_Click"/>
                    </StackPanel>
                    <ListBox x:Name="lstPresets" Height="380" Foreground="#cccccc" DisplayMemberPath="Name"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel>
                    <TextBlock Text="Preset Folder Path:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPresetFolder" Width="400" Margin="0,0,0,8"/>
                    <TextBlock Text="Version Retention Count:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtRetention" Width="120" Margin="0,0,0,8"/>
                    <Button x:Name="btnSaveSettings" Content="Save Settings" Width="140" Height="32" Click="BtnSaveSettings_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,20,0,0" Background="#2d2d2d" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Foreground="#888888" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
